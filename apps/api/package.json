{
  "name": "@relayforge/api",
  "version": "0.0.0",
  "private": true,
  "description": "RelayForge HTTP API and background workers",
  "license": "MIT",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "test": "jest",
    "test:integration": "node --experimental-vm-modules --disable-warning=ExperimentalWarning --env-file-if-exists=../../.env ./node_modules/jest/bin/jest.js --config jest.integration.config.js --runInBand",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:check-drift": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code"
  },
  "dependencies": {
    "@nestjs/common": "11.2.3",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-express": "11.2.3",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.5.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@relayforge/shared": "workspace:*",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "express": "5.2.1",
    "ioredis": "5.11.1",
    "nestjs-pino": "5.1.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.3",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.4",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "jest": "30.5.1",
    "pg": "8.23.0",
    "prisma": "7.10.0",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "tsx": "4.23.13"
  }
}
