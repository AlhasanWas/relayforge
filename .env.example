# Local development configuration. Copy to `.env`; never commit real secrets.

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=relayforge
POSTGRES_PASSWORD=relayforge
POSTGRES_DB=relayforge
POSTGRES_PORT=5432
DATABASE_URL=postgresql://relayforge:relayforge@localhost:5432/relayforge

# --- Redis --------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- API ----------------------------------------------------------------------
NODE_ENV=development
HTTP_PORT=3000
LOG_LEVEL=info
SWAGGER_ENABLED=true

# Requests per API key per window across the management API.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MANAGEMENT_MAX=300

# DEVELOPMENT-ONLY VALUES. These are public in this repository. Generate your own
# for any shared or deployed environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# AES-256-GCM key for stored signing secrets (32 bytes, base64).
ENCRYPTION_KEY=B9PRLYA/pkO4efPNvW151rtrpzR3YzG10+GUrPRwavU=
# ADMIN key created for the demo workspace by `pnpm --filter @relayforge/api db:seed`.
SEED_ADMIN_API_KEY=rf_ba7773086dddea59_qyogN_v52ghNawks7KjNZ3jwNcVHVA2_vfrHNE-0R40

# --- Integration tests (the database name must end with "_test") ---------------
TEST_DATABASE_URL=postgresql://relayforge:relayforge@localhost:5432/relayforge_test
TEST_REDIS_URL=redis://localhost:6379/1
