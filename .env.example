# Local development configuration. Copy to `.env`; never commit real secrets.

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=relayforge
POSTGRES_PASSWORD=relayforge
POSTGRES_DB=relayforge
POSTGRES_PORT=5432
DATABASE_URL=postgresql://relayforge:relayforge@localhost:5432/relayforge

# --- Redis --------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
