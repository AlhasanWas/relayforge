# Local development configuration. Copy to `.env`; never commit real secrets.

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=relayforge
POSTGRES_PASSWORD=relayforge
POSTGRES_DB=relayforge
POSTGRES_PORT=5432
DATABASE_URL=postgresql://relayforge:relayforge@localhost:5432/relayforge

# --- Redis --------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Published ports (docker compose) -----------------------------------------
API_PORT=3000
SINK_PORT=4000

# --- API ----------------------------------------------------------------------
NODE_ENV=development
HTTP_PORT=3000
LOG_LEVEL=info
SWAGGER_ENABLED=true

# Requests per API key per window across the management API.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MANAGEMENT_MAX=300

# DEVELOPMENT-ONLY VALUES. These are public in this repository. Generate your own
# for any shared or deployed environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# AES-256-GCM key for stored signing secrets (32 bytes, base64).
ENCRYPTION_KEY=B9PRLYA/pkO4efPNvW151rtrpzR3YzG10+GUrPRwavU=
# ADMIN key created for the demo workspace by `pnpm --filter @relayforge/api db:seed`.
SEED_ADMIN_API_KEY=rf_ba7773086dddea59_qyogN_v52ghNawks7KjNZ3jwNcVHVA2_vfrHNE-0R40

# --- Webhook ingestion --------------------------------------------------------
INGESTION_MAX_BODY_BYTES=1048576
# Requests per ingress key and client IP per window.
RATE_LIMIT_INGESTION_MAX=1200
# Reverse proxies in front of the API whose X-Forwarded-For entries are trusted.
HTTP_TRUST_PROXY_HOPS=0

# DEVELOPMENT-ONLY demo MockPay connection created by the seed and used by the
# MockPay demo scripts. The ingress key is a routing id; the secret signs webhooks.
DEMO_MOCKPAY_INGRESS_KEY=ing_2osY6rY6HRuYIsNTqfg_Vz5h
DEMO_MOCKPAY_SIGNING_SECRET=whsec_bmh91+MppNWnm+YTICsItke7kiLdfteec0WjLQAzCA0=

# --- Worker -------------------------------------------------------------------
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=100
EVENT_PROCESSING_CONCURRENCY=5
# Processing runs allowed while waiting for a dependency (e.g. refund before payment).
EVENT_PROCESSING_MAX_ATTEMPTS=10

# --- Deliveries ---------------------------------------------------------------
# Demo-scale retry timings, so a failing delivery reaches DEAD_LETTER within a minute.
# The built-in defaults when unset are 8 attempts, a 10 s base delay and a 1 h cap.
DELIVERY_MAX_ATTEMPTS=5
DELIVERY_TIMEOUT_MS=10000
DELIVERY_RETRY_BASE_MS=2000
DELIVERY_RETRY_MAX_MS=30000
# Exact codes and classes treated as transient.
DELIVERY_RETRYABLE_STATUS_CODES=408,429,5xx
# SSRF protection: refuse private, loopback and link-local destinations.
# Only disable for local development against a private webhook sink.
DELIVERY_ALLOW_PRIVATE_DESTINATIONS=false

# --- Recovery sweep ------------------------------------------------------------
MAINTENANCE_INTERVAL_MS=30000
RECOVERY_STALE_AFTER_MS=300000
# Plain-http endpoint URLs are refused unless enabled (local webhook sink only).
ENDPOINT_ALLOW_HTTP=false

# --- Demo scripts (pnpm demo:event, demo:duplicate, demo:sink) -----------------
RELAYFORGE_API_URL=http://localhost:3000
WEBHOOK_SINK_URL=http://localhost:4000
# Seeded endpoint for host-run development; compose sets its own container URL.
DEMO_WEBHOOK_ENDPOINT_URL=http://localhost:4000/webhooks

# --- Integration tests (the database name must end with "_test") ---------------
TEST_DATABASE_URL=postgresql://relayforge:relayforge@localhost:5432/relayforge_test
TEST_REDIS_URL=redis://localhost:6379/1
