{
  "name": "relayforge",
  "version": "0.0.0",
  "private": true,
  "description": "Webhook ingestion, transaction processing, and reliable webhook delivery platform",
  "license": "MIT",
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": ">=24.11.0 <25",
    "pnpm": "11.26.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm --filter @relayforge/shared run build && pnpm -r run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r run test",
    "test:integration": "pnpm -r run test:integration"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.4",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
