{
  "name": "relayforge",
  "version": "0.0.0",
  "private": true,
  "description": "Webhook ingestion, transaction processing, and reliable webhook delivery platform",
  "license": "MIT",
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": ">=24.11.0",
    "pnpm": "11.26.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm --filter @relayforge/shared run build && pnpm -r run typecheck && tsc -p scripts/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r run test",
    "test:integration": "pnpm -r run test:integration",
    "demo:event": "tsx scripts/demo/send-event.ts",
    "demo:duplicate": "tsx scripts/demo/send-duplicates.ts",
    "demo:sink": "tsx scripts/demo/set-sink-mode.ts",
    "demo:benchmark": "tsx scripts/demo/benchmark.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.5",
    "@relayforge/shared": "workspace:*",
    "@types/node": "24.13.4",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
